NODE_ENV=development
PORT=4000
# Local development only; credentials must match the root .env file.
DATABASE_URL=postgresql://linkup:linkup_local_only@localhost:5432/linkup?schema=public
# Run npm run setup:env to fill distinct random secrets in your ignored local .env.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# External integrations are disabled until explicitly approved.
# Supported: disabled | groq | gemini. Approve live calls before enabling both switches.
LLM_PROVIDER=disabled
LLM_LIVE_CALLS_APPROVED=false
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_PROVIDER=disabled
EMAIL_LIVE_CALLS_APPROVED=false
BREVO_API_KEY=
GOOGLE_OAUTH_ENABLED=false
# Canonical frontend origin for certificate verification links (set before public deployment).
PUBLIC_WEB_URL=http://localhost:5173
# In-app reminders only. No email or external scheduler is enabled.
LOCAL_JOBS_ENABLED=false
# Optional remote job bearer secret: at least 32 random characters.
CRON_SECRET=
# Serve the built frontend from Express for a single-origin deployment.
SERVE_WEB=false
# Leave 0 without a trusted reverse proxy; never set this indiscriminately.
TRUST_PROXY_HOPS=0
# Optional local-only demo account. No default/shared password.
DEMO_SEED_EMAIL=demo@linkup.example.invalid
DEMO_SEED_PASSWORD=
