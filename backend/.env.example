NODE_ENV=development
PORT=4000
# Local development only; credentials must match the root .env file.
DATABASE_URL=postgresql://linkup:linkup_local_only@localhost:5432/linkup?schema=public
# Run npm run setup:env to fill distinct random secrets in your ignored local .env.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# External integrations are disabled until explicitly approved.
# Supported now: disabled | groq. Approve a live call before enabling both switches.
LLM_PROVIDER=disabled
LLM_LIVE_CALLS_APPROVED=false
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
