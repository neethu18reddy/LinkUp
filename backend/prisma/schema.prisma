generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalSource {
  DIRECT
  QUIZ
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoadmapStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TopicStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PlanItemStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum FlexibilityMode {
  RELAXED
  STANDARD
  INTENSIVE
  DEADLINE
}

enum MessageRole {
  USER
  ASSISTANT
}

enum NotificationType {
  WEEKLY_REMINDER
  BEHIND_SCHEDULE
  MILESTONE
  CERTIFICATE_READY
}

enum UsageKind {
  ROADMAP
  CHAT
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(254)
  passwordHash       String
  name               String              @db.VarChar(100)
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  skills             UserSkill[]
  goals              Goal[]
  quizResponses      QuizResponse[]
  roadmaps           Roadmap[]
  learningLogs       LearningLog[]
  projectSubmissions ProjectSubmission[]
  chatSessions       ChatSession[]
  certificates       Certificate[]
  notifications      Notification[]
  dailyUsage         DailyUsage[]
  remindersEnabled   Boolean             @default(true)
  identity           AccountIdentity?
  accountTokens      AccountToken[]
  studioResources    StudioResource[]
  skillProgress      UserSkillProgress[]
  studioSettings     UserSettings?
  studioNotes        StudioNote[]
  studioSnippets     CodeSnippet[]
  studioDailyStats   DailyStat[]
  studioRecaps       DailyRecap[]
  studioWatchEvents  WatchEvent[]
  studioWatchSessions WatchSession[]
  studioWatchLease   WatchLease?
  studioItemProgress ItemProgress[]
  studioActivities   StudioActivity[]
  skillProgressEvents SkillProgressEvent[]
}

model AccountIdentity {
  userId        String    @id @db.Uuid
  googleSubject String?   @unique @db.VarChar(255)
  verifiedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String    @db.VarChar(20)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([expiresAt])
}

model ScheduledJobState {
  id        String   @id @db.VarChar(100)
  cursor    String?  @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Skill {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique @db.VarChar(100)
  normalizedName   String            @unique @db.VarChar(100)
  category         String            @db.VarChar(100)
  aliases          String[]          @default([])
  userSkills       UserSkill[]
  roleRequirements RoleRequirement[]
  topics           Topic[]
  progress         UserSkillProgress[]
  studioSections   StudioSectionSkill[]
  progressEvents   SkillProgressEvent[]

  @@index([category])
}

model UserSkill {
  userId    String      @db.Uuid
  skillId   String      @db.Uuid
  level     Proficiency
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model RoleTemplate {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique @db.VarChar(100)
  title           String            @db.VarChar(150)
  description     String
  fallbackRoadmap Json?
  updatedAt       DateTime          @updatedAt
  requirements    RoleRequirement[]
  goals           Goal[]
  studioResources StudioResource[]
}

model RoleRequirement {
  roleTemplateId String       @db.Uuid
  skillId        String       @db.Uuid
  requiredLevel  Proficiency
  weight         Int          @default(1)
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, skillId])
  @@index([skillId])
}

model Goal {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  roleTemplateId String?       @db.Uuid
  targetRole     String        @db.VarChar(150)
  source         GoalSource    @default(DIRECT)
  status         GoalStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTemplate   RoleTemplate? @relation(fields: [roleTemplateId], references: [id], onDelete: SetNull)
  roadmaps       Roadmap[]

  @@index([userId, status])
  @@index([roleTemplateId])
}

model QuizResponse {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  answers          Json
  recommendedRoles Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Roadmap {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  goalId              String        @db.Uuid
  title               String        @db.VarChar(200)
  totalEstimatedHours Decimal       @db.Decimal(10, 2)
  status              RoadmapStatus @default(DRAFT)
  version             Int           @default(1)
  generationSource    String        @default("template") @db.VarChar(30)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  phases              Phase[]
  plans               Plan[]
  chatSessions        ChatSession[]
  certificate         Certificate?

  @@unique([goalId, version])
  @@index([userId, status])
}

model Phase {
  id          String  @id @default(uuid()) @db.Uuid
  roadmapId   String  @db.Uuid
  order       Int
  title       String  @db.VarChar(200)
  description String
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([roadmapId, order])
}

model Topic {
  id             String              @id @default(uuid()) @db.Uuid
  phaseId        String              @db.Uuid
  skillId        String?             @db.Uuid
  order          Int
  title          String              @db.VarChar(200)
  subtopics      Json                @default("[]")
  estimatedHours Decimal             @db.Decimal(8, 2)
  difficulty     Proficiency
  resources      Json                @default("[]")
  isProject      Boolean             @default(false)
  status         TopicStatus         @default(TODO)
  completedAt    DateTime?
  phase          Phase               @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  skill          Skill?              @relation(fields: [skillId], references: [id], onDelete: SetNull)
  planItems      PlanItem[]
  learningLogs   LearningLog[]
  submissions    ProjectSubmission[]

  @@unique([phaseId, order])
  @@index([skillId])
}

model Plan {
  id               String          @id @default(uuid()) @db.Uuid
  roadmapId        String          @db.Uuid
  hoursPerWeek     Decimal         @db.Decimal(6, 2)
  flexibilityMode  FlexibilityMode @default(STANDARD)
  startDate        DateTime        @db.Date
  targetEndDate    DateTime?       @db.Date
  projectedEndDate DateTime        @db.Date
  version          Int             @default(1)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weeks            PlanWeek[]

  @@unique([roadmapId, version])
  @@index([roadmapId, isActive])
}

model PlanWeek {
  id           String     @id @default(uuid()) @db.Uuid
  planId       String     @db.Uuid
  weekNumber   Int
  startDate    DateTime   @db.Date
  plannedHours Decimal    @db.Decimal(6, 2)
  focusSummary String
  isBuffer     Boolean    @default(false)
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items        PlanItem[]

  @@unique([planId, weekNumber])
  @@index([startDate])
}

model PlanItem {
  id             String         @id @default(uuid()) @db.Uuid
  planWeekId     String         @db.Uuid
  topicId        String         @db.Uuid
  allocatedHours Decimal        @db.Decimal(8, 2)
  status         PlanItemStatus @default(TODO)
  completedAt    DateTime?
  planWeek       PlanWeek       @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([planWeekId, topicId])
  @@index([topicId])
}

model LearningLog {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  topicId   String?  @db.Uuid
  minutes   Int
  note      String   @db.VarChar(2000)
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([userId, loggedAt])
  @@index([topicId])
}

model ProjectSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  topicId     String   @db.Uuid
  title       String   @db.VarChar(200)
  repoUrl     String?  @db.VarChar(2048)
  notes       String?  @db.VarChar(5000)
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId])
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  roadmapId String?       @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap   Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  version   Int           @default(0)
  busyToken String?       @db.Uuid
  busyUntil DateTime?

  @@index([userId, createdAt])
  @@index([roadmapId])
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  content   String
  requestId String      @default(uuid()) @db.Uuid
  position  Int
  mode      String      @default("offline") @db.VarChar(30)
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@unique([sessionId, requestId, role])
  @@index([sessionId, createdAt])
}

model Certificate {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  roadmapId        String   @unique @db.Uuid
  verificationCode String   @unique @db.VarChar(128)
  recipientName    String   @db.VarChar(100)
  roleTitle        String   @db.VarChar(200)
  completedHours   Decimal  @db.Decimal(10, 2)
  issuedAt         DateTime @default(now())
  storageKey       String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap          Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  type             NotificationType
  title            String           @db.VarChar(200)
  message          String           @db.VarChar(2000)
  deduplicationKey String           @unique
  createdAt        DateTime         @default(now())
  readAt           DateTime?
  sentAt           DateTime?
  emailClaimedAt   DateTime?
  emailAttempts    Int              @default(0)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model DailyUsage {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  date   DateTime  @db.Date
  kind   UsageKind
  count  Int       @default(0)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, kind])
}

enum SkillProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum SkillProgressSource {
  MANUAL
  RESOURCE
  ASSESSMENT
}

model UserSkillProgress {
  userId         String @db.Uuid
  skillId        String @db.Uuid
  status         SkillProgressStatus @default(NOT_STARTED)
  percent        Float @default(0)
  source         SkillProgressSource @default(MANUAL)
  manualComplete Boolean @default(false)
  beforeTracking Boolean @default(false)
  completedAt    DateTime?
  updatedAt      DateTime @default(now()) @updatedAt
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([userId, skillId])
  @@index([userId, status])
}

model UserSettings {
  userId                 String @id @db.Uuid
  timezone               String @default("UTC") @db.VarChar(100)
  timezoneConfirmed      Boolean @default(false)
  dailyGoalType          String @default("minutes") @db.VarChar(10)
  dailyGoalValue         Int @default(20)
  autoplayNext           Boolean @default(false)
  emojiRecap             Boolean @default(true)
  confirmSkillCompletion Boolean @default(false)
  completionThreshold    Float @default(0.9)
  user                   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudioResource {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @db.Uuid
  provider         String @db.VarChar(20)
  externalId       String? @db.VarChar(200)
  title            String @db.VarChar(200)
  channel          String @default("") @db.VarChar(200)
  thumbnailUrl     String? @db.VarChar(2048)
  totalDurationSec Int @default(0)
  videoCount       Int @default(0)
  status           String @default("active") @db.VarChar(20)
  importedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  targetRoleId     String? @db.Uuid
  targetRole       RoleTemplate? @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)
  version          Int @default(1)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections         StudioSection[]
  items            ResourceItem[]
  notes            StudioNote[]
  snippets         CodeSnippet[]
  activities       StudioActivity[]
  watchEvents      WatchEvent[]
  dailyStats       DailyStat[]
  @@index([userId, importedAt])
}

model StudioSection {
  id               String @id @default(uuid()) @db.Uuid
  resourceId       String @db.Uuid
  order            Int
  title            String @db.VarChar(200)
  topicSummary     String @db.VarChar(500)
  topicTags        String[] @default([])
  totalDurationSec Int @default(0)
  resource         StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  items            ResourceItem[]
  skills           StudioSectionSkill[]
  snippets         CodeSnippet[]
  @@unique([resourceId, order])
  @@unique([id, resourceId])
}

model StudioSectionSkill {
  sectionId String @db.Uuid
  skillId   String @db.Uuid
  confidence Float @default(1)
  section   StudioSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([sectionId, skillId])
  @@index([skillId])
}

model ResourceItem {
  id               String @id @default(uuid()) @db.Uuid
  resourceId       String @db.Uuid
  sectionId        String @db.Uuid
  order            Int
  externalVideoId  String? @db.VarChar(20)
  title            String @db.VarChar(200)
  url              String? @db.VarChar(2048)
  durationSec      Int @default(0)
  thumbnailUrl     String? @db.VarChar(2048)
  available        Boolean @default(true)
  resource         StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  section          StudioSection @relation(fields: [sectionId, resourceId], references: [id, resourceId], onDelete: Cascade)
  progress         ItemProgress[]
  notes            StudioNote[]
  snippets         CodeSnippet[]
  watchEvents      WatchEvent[]
  watchSessions    WatchSession[]
  activities       StudioActivity[]
  @@unique([resourceId, order])
  @@index([sectionId])
}

model ItemProgress {
  userId            String @db.Uuid
  itemId            String @db.Uuid
  watchedSec        Float @default(0)
  contentWatchedSec Float @default(0)
  lastPositionSec   Float @default(0)
  status            String @default("not_started") @db.VarChar(20)
  completedAt       DateTime?
  firstCompletedAt  DateTime?
  completedBy       String? @db.VarChar(10)
  updatedAt         DateTime @default(now()) @updatedAt
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item              ResourceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@id([userId, itemId])
}

model WatchSession {
  id          String @id @db.Uuid
  userId      String @db.Uuid
  itemId      String @db.Uuid
  startedAt   DateTime @default(now())
  lastAt      DateTime @default(now())
  wallSec     Float @default(0)
  contentSec  Float @default(0)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        ResourceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  leases      WatchLease[]
  @@index([userId, lastAt])
}

model WatchLease {
  userId    String @id @db.Uuid
  sessionId String @db.Uuid
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   WatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WatchEvent {
  id             String @id @default(uuid()) @db.Uuid
  requestId      String @db.Uuid
  userId         String @db.Uuid
  resourceId     String @db.Uuid
  itemId         String @db.Uuid
  startedAt      DateTime
  endedAt        DateTime
  secondsWatched Float
  contentSeconds Float
  localDate      String @db.VarChar(10)
  timezone       String @db.VarChar(100)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource       StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  item           ResourceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId, localDate])
  @@index([userId, localDate])
  @@index([resourceId, startedAt])
}

model StudioActivity {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  resourceId String @db.Uuid
  kind       String @db.VarChar(40)
  title      String @db.VarChar(200)
  itemId     String? @db.Uuid
  requestId  String? @unique @db.Uuid
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  item       ResourceItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  @@index([resourceId, createdAt])
}

model StudioNote {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  resourceId   String @db.Uuid
  itemId       String? @db.Uuid
  timestampSec Float @default(0)
  bodyMd       String @db.VarChar(20000)
  type         String @default("Key idea") @db.VarChar(20)
  pinned       Boolean @default(false)
  tags         String[] @default([])
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  item         ResourceItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
  @@index([resourceId, itemId])
}

model CodeSnippet {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  resourceId   String @db.Uuid
  itemId       String? @db.Uuid
  sectionId    String? @db.Uuid
  title        String @db.VarChar(200)
  language     String @db.VarChar(20)
  code         String @db.VarChar(50000)
  timestampSec Float @default(0)
  version      Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  item         ResourceItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  section      StudioSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  versions     SnippetVersion[]
  runs         SnippetRun[]
  @@index([userId, updatedAt])
  @@index([resourceId, itemId])
}

model SnippetVersion {
  id        String @id @default(uuid()) @db.Uuid
  snippetId String @db.Uuid
  code      String @db.VarChar(50000)
  savedAt   DateTime @default(now())
  snippet   CodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  @@index([snippetId, savedAt])
}

model SnippetRun {
  id         String @id @db.Uuid
  snippetId  String @db.Uuid
  language   String @db.VarChar(20)
  status     String @db.VarChar(20)
  durationMs Int
  createdAt  DateTime @default(now())
  snippet    CodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  @@index([snippetId, createdAt])
}

model DailyStat {
  userId          String @db.Uuid
  resourceId      String @db.Uuid
  localDate       String @db.VarChar(10)
  secondsWatched  Float @default(0)
  contentSeconds  Float @default(0)
  videosCompleted Int @default(0)
  notesCount      Int @default(0)
  snippetsCount   Int @default(0)
  runsCount       Int @default(0)
  topicTags       String[] @default([])
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource        StudioResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@id([userId, resourceId, localDate])
  @@index([userId, localDate])
}

model DailyRecap {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  localDate   String @db.VarChar(10)
  payload     Json
  generatedAt DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, localDate])
}

model StudioPlaylistCache {
  externalId String @id @db.VarChar(200)
  payload    Json
  expiresAt  DateTime
}

model SkillProgressEvent {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  skillId    String @db.Uuid
  status     SkillProgressStatus
  source     SkillProgressSource
  percent    Float
  occurredAt DateTime?
  legacy     Boolean @default(false)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@index([userId, occurredAt])
}
