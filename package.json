{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "description": "A personalised learning and career roadmap application.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "setup:demo": "node scripts/setup-env.mjs --demo",
    "setup:production": "node scripts/setup-production.mjs",
    "db:local:install": "npm install --prefix .local/postgres-runtime embedded-postgres@16.14.0-beta.17 --save-exact --no-fund --no-audit",
    "db:local:start": "node scripts/local-postgres.mjs",
    "db:local:stop": "node scripts/local-postgres.mjs --stop",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:migrate": "npm run db:migrate -w backend --",
    "db:deploy": "npm run db:deploy -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:seed:demo": "npm run db:seed:demo -w backend",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run db:validate && npm run build",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  }
}
