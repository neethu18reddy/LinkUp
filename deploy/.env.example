# Copy to deploy/.env, configure privately, and never commit the result.
POSTGRES_PASSWORD=
# Must match POSTGRES_PASSWORD; use a hex password or URL-encode it here.
DATABASE_URL=postgresql://linkup:REPLACE_PASSWORD@postgres:5432/linkup
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PUBLIC_WEB_URL=https://REPLACE_WITH_YOUR_HOST
CLIENT_URL=https://REPLACE_WITH_YOUR_HOST
# Set to 1 only behind exactly one trusted, non-bypassable reverse proxy.
TRUST_PROXY_HOPS=0
NODE_ENV=production
SERVE_WEB=true
PORT=4000
LOG_LEVEL=info
LLM_PROVIDER=disabled
LLM_LIVE_CALLS_APPROVED=false
LOCAL_JOBS_ENABLED=false
CRON_SECRET=
