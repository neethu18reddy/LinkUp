{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "HUSKY=0 npm ci --include=dev",
  "buildCommand": "npm run build && node scripts/vercel-migrate.mjs",
  "outputDirectory": "frontend/dist",
  "crons": [{ "path": "/api/v1/internal/jobs/daily", "schedule": "0 7 * * *" }],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{backend/dist/**,backend/prisma/data/**,node_modules/@fontsource/noto-sans/files/**,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
